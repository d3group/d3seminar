# Copy to .env.production on the backend host and replace this hostname.
D3_API_HOST=seminar-api.example.org
D3_SITE_URL=https://d3group.github.io/d3seminar/
# Existing private data directory; use a separate copy from any running local setup.
D3_DATA_PATH=./data
# Set these to the numeric owner/group of the data directory on that host.
D3_UID=10001
D3_GID=10001
# Enable with --profile backups after initializing/synchronizing the data.
D3_BACKUP_PATH=./backups
D3_BACKUP_KEEP=30
D3_BACKUP_HOUR=3
D3_BACKUP_TIMEZONE=Europe/Berlin
